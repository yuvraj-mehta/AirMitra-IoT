#include <PubSubClient.h>
#include <WiFi.h>

// Update these with your values
const char *ssid = "NITP";
const char *password = "Admin#2024";
const char *mqtt_server =
    "43.205.165.107";            // YOUR COMPUTER'S IP RUNNING MOSQUITTO
const char *device_id = "LB01"; // Device ID from dashboard

WiFiClient espClient;
PubSubClient client(espClient);

// ESP32 onboard LED (most devkits use GPIO 2)
const int ledPin = 13;
const int ledPwmChannel = 0;
const int ledPwmFreq = 5000;
const int ledPwmResolution = 8; // 0-255

// Bulb State
bool powerOn = false;
int brightness = 80;
String currentColor = "#FFFFFF";

String cmdBaseTopic;
String stateBaseTopic;

void applyLedState()
{
  int duty = 0;

  if (powerOn)
  {
    int constrainedBrightness = constrain(brightness, 0, 100);
    duty = map(constrainedBrightness, 0, 100, 0, 255);
  }

  ledcWrite(ledPwmChannel, duty);
  Serial.print("[LED] power=");
  Serial.print(powerOn ? "ON" : "OFF");
  Serial.print(", brightness=");
  Serial.print(brightness);
  Serial.print("%, pwm=");
  Serial.println(duty);
}

bool publishWithLog(const char *topic, const String &payload, bool retained = true)
{
  bool ok = client.publish(topic, payload.c_str(), retained);
  Serial.print("[MQTT TX] ");
  Serial.print(topic);
  Serial.print(" => ");
  Serial.print(payload);
  Serial.print(" (");
  Serial.print(ok ? "OK" : "FAIL");
  Serial.println(")");
  return ok;
}

void publishState()
{
  publishWithLog((stateBaseTopic + "/power").c_str(), powerOn ? "ON" : "OFF");
  publishWithLog((stateBaseTopic + "/brightness").c_str(), String(brightness));
  publishWithLog((stateBaseTopic + "/color").c_str(), currentColor);
}

void setup_wifi()
{
  delay(10);
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("WiFi connected");
  Serial.print("ESP32 IP address: ");
  Serial.println(WiFi.localIP());
  Serial.print("Gateway: ");
  Serial.println(WiFi.gatewayIP());
  Serial.print("Subnet: ");
  Serial.println(WiFi.subnetMask());
  Serial.print("MQTT server: ");
  Serial.println(mqtt_server);
}

void callback(char *topic, byte *payload, unsigned int length)
{
  String message = "";
  for (int i = 0; i < length; i++)
  {
    message += (char)payload[i];
  }
  message.trim();

  Serial.print("[MQTT RX] ");
  Serial.print(topic);
  Serial.print(" => ");
  Serial.println(message);

  String topicStr = String(topic);
  bool stateChanged = false;

  if (topicStr.endsWith("/power"))
  {
    if (message == "ON")
    {
      powerOn = true;
      Serial.println("Bulb: ON");
      stateChanged = true;
    }
    else if (message == "OFF")
    {
      powerOn = false;
      Serial.println("Bulb: OFF");
      stateChanged = true;
    }
    else
    {
      Serial.println("[WARN] Unsupported power payload");
    }
  }
  else if (topicStr.endsWith("/brightness"))
  {
    brightness = constrain(message.toInt(), 0, 100);
    Serial.print("Brightness set to: ");
    Serial.println(brightness);
    stateChanged = true;
  }
  else if (topicStr.endsWith("/color"))
  {
    currentColor = message;
    Serial.print("Color set to: ");
    Serial.println(currentColor);
    stateChanged = true;
  }
  else
  {
    Serial.println("[WARN] Received message on unhandled topic");
  }

  if (stateChanged)
  {
    applyLedState();
    publishState();
  }
}

void reconnect()
{
  while (!client.connected())
  {
    Serial.print("Attempting MQTT connection...");
    Serial.print(" (broker ");
    Serial.print(mqtt_server);
    Serial.println(":1883)");

    if (client.connect("ESP32_Bulb_LB01"))
    {
      Serial.println("connected");

      // Subscribe to commands
      bool subOk = client.subscribe(cmdBaseTopic.c_str());
      Serial.print("[MQTT SUB] ");
      Serial.print(cmdBaseTopic);
      Serial.print(" (");
      Serial.print(subOk ? "OK" : "FAIL");
      Serial.println(")");

      publishState();
    }
    else
    {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      delay(5000);
    }
  }
}

void setup()
{
  Serial.begin(115200);

  ledcSetup(ledPwmChannel, ledPwmFreq, ledPwmResolution);
  ledcAttachPin(ledPin, ledPwmChannel);

  cmdBaseTopic = "smarthome/cmnd/" + String(device_id) + "/#";
  stateBaseTopic = "smarthome/stat/" + String(device_id);

  setup_wifi();

  Serial.print("Command topic: ");
  Serial.println(cmdBaseTopic);
  Serial.print("State topic base: ");
  Serial.println(stateBaseTopic);

  client.setServer(mqtt_server, 1883);
  client.setCallback(callback);

  applyLedState();
}

void loop()
{
  if (!client.connected())
  {
    reconnect();
  }
  client.loop();
}
